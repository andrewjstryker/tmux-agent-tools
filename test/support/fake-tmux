#!/usr/bin/env bash
# Small tmux protocol fake shared by unit and entry-point tests.

set -u

if [[ -n "${FAKE_TMUX_LOG:-}" ]]; then
  printf '%s\n' "$*" >> "$FAKE_TMUX_LOG"
fi

# Lines of "pane_id pane_pid" for pane lookups.
if [[ "${1:-}" == list-panes ]]; then
  [[ -z "${FAKE_TMUX_PANES:-}" ]] || printf '%s\n' "$FAKE_TMUX_PANES"
  exit 0
fi

if [[ "${1:-}" == display-message ]]; then
  printf '%s' "${FAKE_SESSION:-\$0}"
  exit 0
fi

if [[ ("${1:-} ${2:-}" == 'show -qv' && "${3:-}" == -t) ||
      ("${1:-}" == set && ("${2:-}" == -t || "${2:-}" == -u)) ]]; then
  if [[ "${1:-}" == show ]]; then
    state="$FAKE_TMUX_STATE_DIR/session-${4}-${5#@}"
    [[ ! -f "$state" ]] || cat "$state"
  elif [[ "${2:-}" == -u ]]; then
    rm -f "$FAKE_TMUX_STATE_DIR/session-${4}-${5#@}"
  else
    mkdir -p "$FAKE_TMUX_STATE_DIR"
    printf '%s' "${5:-}" > "$FAKE_TMUX_STATE_DIR/session-${3}-${4#@}"
  fi
  exit 0
fi

fake_state_path() { # <global-option>
  local name="${1#@}"
  printf '%s/global-%s' "$FAKE_TMUX_STATE_DIR" "$name"
}

if [[ ("${1:-}" == show || "${1:-}" == show-options) && "${2:-}" == -gqv ]]; then
  option="${3:-}"
  case "$option" in
    @agent-tools-context-warn) printf '%s' "${FAKE_WARN:-}"; exit 0 ;;
    @agent-tools-context-fail) printf '%s' "${FAKE_FAIL:-}"; exit 0 ;;
    @agent-tools-usage-warn) printf '%s' "${FAKE_USAGE_WARN:-}"; exit 0 ;;
    @agent-tools-usage-fail) printf '%s' "${FAKE_USAGE_FAIL:-}"; exit 0 ;;
    @agent-tools-airline-warned)
      if [[ -n "${FAKE_WARNED+x}" ]]; then
        printf '%s' "$FAKE_WARNED"
        exit 0
      fi
      ;;
    @airline-cli) printf '%s' "${FAKE_AIRLINE_CLI:-}"; exit 0 ;;
    @agent-cli) printf '%s' "${FAKE_AGENT_CLI:-}"; exit 0 ;;
  esac
  if [[ -n "${FAKE_TMUX_STATE_DIR:-}" ]]; then
    state="$(fake_state_path "$option")"
    [[ ! -f "$state" ]] || { command cat "$state"; exit 0; }
  fi
  exit 0
fi

if [[ "${1:-}" == show && "${2:-}" == -pqv ]]; then
  if [[ -n "${FAKE_TMUX_PANE_VALUE_FILE:-}" ]]; then
    command cat "$FAKE_TMUX_PANE_VALUE_FILE"
  else
    printf '%s' "${FAKE_TMUX_PANE_VALUE:-}"
  fi
  exit 0
fi

if [[ "${1:-}" == set && "${2:-}" == -g && -n "${FAKE_TMUX_STATE_DIR:-}" ]]; then
  mkdir -p "$FAKE_TMUX_STATE_DIR"
  printf '%s' "${4:-}" > "$(fake_state_path "${3:-}")"
  exit 0
fi

exit 0
