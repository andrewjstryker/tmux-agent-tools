#!/usr/bin/env bash
# Configurable protocol fake for Agent's outbound Airline calls.

set -u

if [[ -n "${FAKE_AIRLINE_LOG:-}" ]]; then
  printf '%s\n' "$*" >> "$FAKE_AIRLINE_LOG"
fi

# Optional lossless stream: each call is encoded as argc followed by that many
# NUL-terminated arguments. Tests that care about spaces or empty arguments can
# decode this instead of using the human-readable log above.
if [[ -n "${FAKE_AIRLINE_ARGV_LOG:-}" ]]; then
  printf '%s\0' "$#" >> "$FAKE_AIRLINE_ARGV_LOG"
  printf '%s\0' "$@" >> "$FAKE_AIRLINE_ARGV_LOG"
fi

if [[ "${1:-}" == version ]]; then
  [[ "${FAKE_AIRLINE_VERSION_FAIL:-}" != 1 ]] || exit "${FAKE_AIRLINE_FAIL_STATUS:-65}"
  printf '%s\n' "${FAKE_AIRLINE_VERSION:-3.0.0}"
  exit 0
fi

# Validate the strict status/health shapes Agent depends on. This is intentionally
# not an Airline implementation. Agent always supplies an explicit pane target, so
# requiring it here catches a misplaced trailing `-t` that Airline would legally
# consume as opaque message text while mutating the wrong/default window.
if [[ "${1:-} ${2:-}" == 'status set' ]]; then
  [[ $# -eq 5 && "${3:-}" == -t && -n "${4:-}" ]] || exit 64
  case "$5" in active|result|attention) ;; *) exit 64 ;; esac
elif [[ "${1:-} ${2:-}" == 'status clear' ]]; then
  [[ $# -eq 4 && "${3:-}" == -t && -n "${4:-}" ]] || exit 64
elif [[ "${1:-} ${2:-}" == 'health set' ]]; then
  [[ "${3:-}" == -t && -n "${4:-}" && -n "${5:-}" && -n "${6:-}" ]] || exit 64
  case "${7:-}" in
    ok) [[ $# -eq 7 ]] || exit 64 ;;
    warn|fail) [[ $# -ge 8 ]] || exit 64 ;;
    *) exit 64 ;;
  esac
elif [[ "${1:-} ${2:-}" == 'health clear' ]]; then
  [[ $# -eq 6 && "${3:-}" == -t && -n "${4:-}" && -n "${5:-}" && -n "${6:-}" ]] || exit 64
elif [[ "${1:-} ${2:-}" == 'problem set' ]]; then
  [[ "${3:-}" == -t && -n "${4:-}" && -n "${5:-}" && -n "${6:-}" ]] || exit 64
  case "${7:-}" in
    ok) [[ $# -eq 7 ]] || exit 64 ;;
    warn|fail) [[ $# -ge 8 ]] || exit 64 ;;
    *) exit 64 ;;
  esac
elif [[ "${1:-} ${2:-}" == 'problem close' ]]; then
  [[ $# -eq 5 && "${3:-}" == -t && -n "${4:-}" && -n "${5:-}" ]] || exit 64
elif [[ "${1:-} ${2:-}" == 'problem resolve' ]]; then
  [[ $# -eq 4 && -n "${3:-}" && -n "${4:-}" ]] || exit 64
fi

if [[ -n "${FAKE_AIRLINE_FAIL:-}" ]]; then
  case "$*" in
    "$FAKE_AIRLINE_FAIL"|"$FAKE_AIRLINE_FAIL "*)
      exit "${FAKE_AIRLINE_FAIL_STATUS:-65}"
      ;;
  esac
fi

exit 0
